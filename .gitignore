# Kalaila Photography .gitignore

# OS Files
.DS_Store
Thumbs.db
*.log

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if using npm)
node_modules/
package-lock.json
yarn.lock

# Build files
dist/
build/
*.min.js
*.min.css

# Environment variables
.env
.env.local

# Cache
.cache/
.tmp/

# Backup files
*.bak
*.backup
*~

# OS generated files
ehthumbs.db
.DS_Store
.AppleDouble
.LSOverride

# IDE temporary files
*.sublime-workspace
*.sublime-project

# Compressed files
*.zip
*.rar
*.7z
